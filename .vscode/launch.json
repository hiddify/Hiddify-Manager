{
    "configurations": [
        {
            "name": "Debug current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "/opt/hiddify-manager/.venv313/bin/python",
            "debugAdapterPython": "/opt/hiddify-manager/.venv313/bin/python",
            "args": [],
            "jinja": true,
            "justMyCode": true
        },
        {
            "type": "bashdb",
            "request": "launch",
            "name": "Bash-Debug (select script from list of sh files)",
            "cwd": "${workspaceFolder}",
            "program": "${command:SelectScriptName}",
            "args": []
        },
        {
            "name": "Run HiddifyPanel and Server (apply config and run flask)",
            "type": "debugpy",
            "request": "launch",
            "module": "hiddifypanel.apps.asgi_dev",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "preLaunchTask": "build-hiddify-manager",
            "cwd": "${workspaceFolder}/services/panel/src/",
            "env": {
                "FLASK_APP": "wsgi.py",
                "FLASK_DEBUG": "1",
                "HIDDIFY_CFG_PATH": "/opt/hiddify-manager/data/hiddify-panel/app.cfg",
            },
            "python": "/opt/hiddify-manager/.venv313/bin/python",
            "debugAdapterPython": "/opt/hiddify-manager/.venv313/bin/python",
            // ASGI (Flask + the nodes' WebSocket) in this process; no reload on changes: restart the session
            "args": [
                "--host",
                "0.0.0.0",
                "--port",
                "9000"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Admin V2 Dev: Flask (backend)",
            "type": "debugpy",
            "request": "launch",
            "module": "hiddifypanel.apps.asgi_dev",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "preLaunchTask": "stop panel service",
            "cwd": "${workspaceFolder}/services/panel/src/",
            "env": {
                "FLASK_APP": "wsgi.py",
                "FLASK_DEBUG": "1",
                "HIDDIFY_CFG_PATH": "/opt/hiddify-manager/data/hiddify-panel/app.cfg",
                // HAProxy's panel backend is 127.0.0.1:9000. Vite serves the Admin V2 frontend on 9001.
                "HIDDIFY_ADMIN_V2_DEV": "http://127.0.0.1:9001"
            },
            "python": "/opt/hiddify-manager/.venv313/bin/python",
            "debugAdapterPython": "/opt/hiddify-manager/.venv313/bin/python",
            // ASGI (Flask + the nodes' WebSocket) in this process; no reload on changes: restart the session
            "args": [
                "--host",
                "0.0.0.0",
                "--port",
                "9000"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Run HiddifyPanel Only (make sure to apply config before)",
            "type": "debugpy",
            "request": "launch",
            "module": "hiddifypanel.apps.asgi_dev",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "preLaunchTask": "stop panel service",
            "cwd": "${workspaceFolder}/services/panel/src/",
            "env": {
                "FLASK_APP": "wsgi.py",
                "FLASK_DEBUG": "1",
                "HIDDIFY_CFG_PATH": "/opt/hiddify-manager/data/hiddify-panel/app.cfg",
                // Vite serves the Admin V2 frontend on 9001. This panel stays on 9000, where HAProxy connects.
                "HIDDIFY_ADMIN_V2_DEV": "http://127.0.0.1:9001"
            },
            "python": "/opt/hiddify-manager/.venv313/bin/python",
            "debugAdapterPython": "/opt/hiddify-manager/.venv313/bin/python",
            // ASGI (Flask + the nodes' WebSocket) in this process; no reload on changes: restart the session
            "args": [
                "--host",
                "0.0.0.0",
                "--port",
                "9000"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Apply Config Only",
            "type": "debugpy",
            "preLaunchTask": "build-hiddify-manager",
            "request": "launch",
            "python": "/opt/hiddify-manager/.venv313/bin/python",
            "debugAdapterPython": "/opt/hiddify-manager/.venv313/bin/python",
            "args": [
                "-c",
                "print('build complete')"
            ]
        },
        {
            "name": "Admin V2: Vite Dev",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/services/panel/src/hiddifypanel/admin_v2",
            "command": "npm run dev",
            "env": {
                "VITE_DEV_PORT": "9001",
                "VITE_DEV_HOST": "127.0.0.1"
            }
        },
        {
            "name": "Admin V2: Build",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/services/panel/src/hiddifypanel/admin_v2",
            "command": "bash scripts/build.sh"
        },
        {
            "name": "Dump server configs",
            "type": "debugpy",
            "request": "launch",
            "module": "hiddifypanel",
            "cwd": "${workspaceFolder}/services/panel/src/",
            "env": {
                "FLASK_APP": "wsgi.py",
                "FLASK_DEBUG": "1",
                "HIDDIFY_CFG_PATH": "/opt/hiddify-manager/data/hiddify-panel/app.cfg",
            },
            "python": "/opt/hiddify-manager/.venv313/bin/python",
            "debugAdapterPython": "/opt/hiddify-manager/.venv313/bin/python",
            "args": [
                "dump-server-configs",
                "examples/t1",
                "--refresh-db"
            ]
        },
        {
            "name": "Dump client configs",
            "type": "debugpy",
            "request": "launch",
            "module": "hiddifypanel",
            "cwd": "${workspaceFolder}/services/panel/src/",
            "env": {
                "FLASK_APP": "wsgi.py",
                "FLASK_DEBUG": "1",
                "HIDDIFY_CFG_PATH": "/opt/hiddify-manager/data/hiddify-panel/app.cfg",
            },
            "python": "/opt/hiddify-manager/.venv313/bin/python",
            "debugAdapterPython": "/opt/hiddify-manager/.venv313/bin/python",
            "args": [
                "dump-client-configs",
                "examples/t2",
                "--refresh-db"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Admin V2 Dev (Flask + Vite)",
            "configurations": [
                "Admin V2 Dev: Flask (backend)",
                "Admin V2: Vite Dev"
            ],
            "stopAll": true,
            "presentation": {
                "order": 1
            }
        },
        {
            "name": "Admin V2 (Flask + Vite)",
            "configurations": [
                "Run HiddifyPanel Only (make sure to apply config before)",
                "Admin V2: Vite Dev"
            ],
            "stopAll": true
        }
    ]
}