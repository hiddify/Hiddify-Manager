{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-hiddify-manager", // Define the build task
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "pushd ${workspaceFolder} &&make build && (systemctl kill hiddify-panel||echo '')&&popd"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "stop panel service",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "(systemctl stop --now hiddify-panel||echo '')"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build-admin-v2",
            "type": "shell",
            "command": "bash",
            "options": {
                "cwd": "${workspaceFolder}/services/panel/src/hiddifypanel/admin_v2"
            },
            "args": [
                "-c",
                "bash scripts/build.sh"
            ],
            "group": "build"
        },
        {
            "label": "admin-v2-vite-dev",
            "type": "shell",
            "command": "bash",
            "options": {
                "cwd": "${workspaceFolder}/services/panel/src/hiddifypanel/admin_v2"
            },
            "args": [
                "-c",
                "bash scripts/dev.sh"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE",
                    "endsPattern": "ready in|Local:"
                }
            }
        }
    ]
}