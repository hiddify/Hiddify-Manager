source /opt/hiddify-manager/scripts/common/utils.sh

if [ "$MODE" != "docker" ];then
  if [[ '{{hconfigs['country']}}' == 'cn' ]]; then
      TIMEZONE=Asia/Shanghai
  elif [[ '{{hconfigs['country']}}' == 'ru' ]]; then
      TIMEZONE=Europe/Moscow
  else
      TIMEZONE=Asia/Tehran
  fi
  CURRENT_TZ=$(timedatectl show --property=Timezone --value)
  if [[ "$CURRENT_TZ" != "$TIMEZONE" ]]; then
      echo "Current timezone is $CURRENT_TZ. Changing to $TIMEZONE..."
      sudo timedatectl set-timezone "$TIMEZONE"
      sudo systemctl restart hiddify-mysql
  fi
fi

# Logs must not fill the disk: cap the journal, empty a file log once it passes 100M.
if [ "$MODE" != "docker" ];then
  mkdir -p /etc/systemd/journald.conf.d
  if ! cmp -s journald.conf /etc/systemd/journald.conf.d/hiddify.conf; then
    cp journald.conf /etc/systemd/journald.conf.d/hiddify.conf
    systemctl restart systemd-journald
  fi
  cp logrotate.conf /etc/logrotate.d/hiddify
  chmod 644 /etc/logrotate.d/hiddify
  echo "17 * * * * root /usr/sbin/logrotate /etc/logrotate.d/hiddify >/dev/null 2>&1" >/etc/cron.d/hiddify_logrotate
fi

# The server's own DNS (the panel's "DNS server" setting, one or more IPs separated by commas): a systemd-resolved
# drop-in, restarted only when it changes (no netplan apply: the network does not go down). Anything that is not an IP
# is left out; with none left, the drop-in goes and the server's own DNS is used again.
if [ "$MODE" != "docker" ];then
  DNS_IPS=""
  for ip in $(echo '{{ (hconfigs['dns_server'] or '') | replace("'", "") }}' | tr ',;' '  '); do
    if [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ || "$ip" =~ ^[0-9a-fA-F:]+:[0-9a-fA-F:]*$ ]]; then
      DNS_IPS="$DNS_IPS $ip"
    fi
  done
  DNS_DROPIN=/etc/systemd/resolved.conf.d/hiddify-dns.conf
  if [ -n "$DNS_IPS" ]; then
    mkdir -p /etc/systemd/resolved.conf.d
    printf '[Resolve]\nDNS=%s\nDomains=~.\n' "${DNS_IPS# }" >"$DNS_DROPIN.new"
    if ! cmp -s "$DNS_DROPIN.new" "$DNS_DROPIN"; then
      mv "$DNS_DROPIN.new" "$DNS_DROPIN"
      systemctl restart systemd-resolved
    else
      rm -f "$DNS_DROPIN.new"
    fi
  elif [ -f "$DNS_DROPIN" ]; then
    rm -f "$DNS_DROPIN"
    systemctl restart systemd-resolved
  fi
fi

# Check if PasswordAuthentication is enabled
if ! grep -rxq "PasswordAuthentication.*no" /etc/ssh/sshd*; then
  chmod a+r /etc/ssh/sshd*
  WARNING_MSG="Hiddify! Your server is vulnerable to abuses because PasswordAuthentication is enabled. To secure your server, please switch to key authentication mechanism and turn off PasswordAuthentication in your ssh config file."
  
  if [[ $(grep "Your server is vulnerable" /etc/motd | wc -l) == 0 ]]; then
    error "$WARNING_MSG" >>/etc/motd 2>&1
  fi
else
  sed -i "/Your server is vulnerable/d" /etc/motd
fi


{% if hconfigs['auto_update'] %}
echo "0 3 * * * root $(pwd)/../update.sh --no-gui --no-log" >/etc/cron.d/hiddify_auto_update
service cron reload
{%else%}
rm -rf /etc/cron.d/hiddify_auto_update
service cron reload
{%endif%}
