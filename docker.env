MYSQL_PASSWORD=mysql-strong-password
MYSQL_DATABASE=hiddifypanel             
MYSQL_USER=hiddifypanel           
SQLALCHEMY_DATABASE_URI="mysql+mysqldb://hiddifypanel:mysql-strong-password@127.0.0.1:3306/hiddifypanel?charset=utf8mb4"
# External database/Redis (optional). Point these at a remote MySQL/MariaDB / Redis
# instead of the built-in containers. docker-init.sh requires both URIs to be set.
# When using them, also disable the now-unused local containers:
#   docker compose -f docker-compose.yml -f docker-compose.external-db.yml up -d
# (or remove the mariadb/redis services and the hiddifymanager depends_on blocks
# from your local docker-compose.yml).
# SQLALCHEMY_DATABASE_URI="mysql+mysqldb://hiddifypanel:STRONG_PASS@db.example.com:3306/hiddifypanel?charset=utf8mb4"
# REDIS_URI_MAIN="redis://:STRONG_PASS@redis.example.com:6379/0"

REDIS_PASSWORD=redis-strong-password
REDIS_URI_MAIN="redis://:redis-strong-password@127.0.0.1:6379/1"