# Hiddify's own MariaDB server config. Loaded exclusively via
# hiddify-mysql.service's --defaults-file, independent of the
# mariadb-server package's /etc/mysql config tree. Everything that must
# persist (data files, this config) lives under
# /opt/hiddify-manager/data/mysql; nothing under /var/lib or /etc is
# required for the server to run.
#
# socket/port are left at their compiled-in defaults (/run/mysqld/mysqld.sock,
# 3306) since /run is a systemd-managed runtime directory recreated on every
# start, not persistent state, and the panel's SQLALCHEMY_DATABASE_URI
# ("...@localhost/...") relies on that default socket path to connect.
#
[client-server]
# Port or socket location where to connect
# port = 3306
socket = /run/mysqld/mysqld.sock

[mysqld]
datadir = /opt/hiddify-manager/data/mysql/db
pid-file = /opt/hiddify-manager/data/mysql/db/mariadb.pid
bind-address = 127.0.0.1
port = 3306
