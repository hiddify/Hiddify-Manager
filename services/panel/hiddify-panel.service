[Unit]
Description=hiddify panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hiddify-panel
WorkingDirectory=/opt/hiddify-manager/services/panel/
Environment="LANG=C.UTF-8"
Environment="HIDDIFY_CFG_PATH=/opt/hiddify-manager/data/hiddify-panel/app.cfg"
# Cap glibc's per-thread malloc arenas; with multiple threads this otherwise
# reserves several extra ~arenas worth of RSS that Python/glibc never gives back.
Environment="MALLOC_ARENA_MAX=2"
# This is a low-traffic admin panel, not a public API; a handful of request
# threads is enough concurrency and each idle thread still costs real RSS.
# ASGI: the Flask app runs on HIDDIFY_PANEL_THREADS threads (a2wsgi) and the
# nodes' WebSocket (/<admin path>/api/v2/node/ws/) on the same port.
# workers-max-rss is a safety net that respawns the worker if it ever balloons.
Environment="HIDDIFY_PANEL_THREADS=10"
# --http defaults to auto: HTTP/1.1 and cleartext HTTP/2 (HAProxy `proto h2`). Do not pass --http 2:
# that mode refuses HTTP/1 and disables WebSockets.
ExecStart=/opt/hiddify-manager/.venv313/bin/python -m granian --interface asgi hiddifypanel.apps.asgi_app:app --port 9000 --workers-max-rss 500
ExecReload=/bin/kill -HUP $MAINPID
#RestartSec=1
#ExecStop=/bin/bash -c "/bin/kill -INT $(/usr/bin/pgrep -f 'hiddifypanel')||echo 'nothing to kill'"
ExecStop=/bin/kill -INT $MAINPID
Restart=always
StandardOutput=file:/opt/hiddify-manager/data/log/hiddify_panel.out.log
StandardError=file:/opt/hiddify-manager/data/log/hiddify_panel.err.log
[Install]
WantedBy=multi-user.target


