[Unit]
Description=hiddify panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hiddify-panel
WorkingDirectory=/opt/hiddify-manager/services/hiddify-panel/
Environment="LANG=C.UTF-8"
Environment="HIDDIFY_CFG_PATH=/opt/hiddify-manager/data/hiddify-panel/app.cfg"
# Cap glibc's per-thread malloc arenas; with multiple threads this otherwise
# reserves several extra ~arenas worth of RSS that Python/glibc never gives back.
Environment="MALLOC_ARENA_MAX=2"
# This is a low-traffic admin panel, not a public API; a handful of blocking
# threads is enough concurrency and each idle thread still costs real RSS.
# workers-max-rss is a safety net that respawns the worker if it ever balloons.
ExecStart=/opt/hiddify-manager/.venv313/bin/python -m granian --interface wsgi hiddifypanel.apps.wsgi_app:app --port 9000 --blocking-threads 4 --workers-max-rss 200
ExecReload=/bin/kill -HUP $MAINPID
#RestartSec=1
#ExecStop=/bin/bash -c "/bin/kill -INT $(/usr/bin/pgrep -f 'hiddifypanel')||echo 'nothing to kill'"
ExecStop=/bin/kill -INT $MAINPID
Restart=always
StandardOutput=file:/opt/hiddify-manager/data/log/system/hiddify_panel.out.log
StandardError=file:/opt/hiddify-manager/data/log/system/hiddify_panel.err.log
[Install]
WantedBy=multi-user.target


