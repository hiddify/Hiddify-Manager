[Unit]
Description=Telemt
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hiddify-manager/services/telegram/telemt/
ExecStart=/opt/hiddify-manager/services/telegram/telemt/telemt /opt/hiddify-manager/generated/telemt.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target