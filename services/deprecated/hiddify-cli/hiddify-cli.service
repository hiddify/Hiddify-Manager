[Unit]
Description=HiddifyCli service
After=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=3
WorkingDirectory=/opt/hiddify-manager/services/hiddify-cli
EnvironmentFile=/opt/hiddify-manager/services/hiddify-cli/.env
ExecStart=/opt/hiddify-manager/services/hiddify-cli/hiddify-core run -c $SUB_LINK -d h_client_config.json
User=hiddify-cli
[Install]
WantedBy=multi-user.target
